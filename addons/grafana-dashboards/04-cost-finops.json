    {
      "id": 9,
      "title": "Kubernetes 모델 비용 요약 — OpenCost / Prometheus",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13},
      "panels": []
    },
    {
      "id": 17,
      "title": "최근 7일 Node 비용",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "OpenCost Node 가격 모델 기준 최근 7일 비용입니다. CPU/Memory allocation 기반 Hailcast·Worker 비용과 계산 범위가 달라 합산하지 않으며, AWS 실제 청구액이 아닙니다. Prometheus 데이터 유실 구간은 과소계산될 수 있습니다.",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 14},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "avg_over_time(\n  (\n    sum(node_total_hourly_cost)\n    or vector(0)\n  )[7d:30s]\n)\n* 168",
          "legendFormat": "Node 누적 모델 비용",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "currencyUSD", "decimals": 2, "min": 0, "mappings": [], "color": {"mode": "fixed", "fixedColor": "#FCBE17"}},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 18,
      "title": "최근 7일 Hailcast 비용",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "hailcast Namespace의 CPU/Memory allocation 기반 최근 7일 비용입니다. Worker 비용을 포함하는 상위 범위이며 Node 비용과 계산 범위가 달라 합산하지 않습니다. AWS 실제 청구액이 아닙니다.",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 14},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "avg_over_time(\n  (\n    (\n      sum(\n        container_cpu_allocation{namespace=\"hailcast\"}\n        * on(node) group_left()\n        node_cpu_hourly_cost\n      )\n      or vector(0)\n    )\n    +\n    (\n      sum(\n        (\n          container_memory_allocation_bytes{namespace=\"hailcast\"}\n          / 1024 / 1024 / 1024\n        )\n        * on(node) group_left()\n        node_ram_hourly_cost\n      )\n      or vector(0)\n    )\n  )[7d:30s]\n)\n* 168",
          "legendFormat": "Hailcast 누적 할당 모델 비용",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "currencyUSD", "decimals": 2, "min": 0, "mappings": [], "color": {"mode": "fixed", "fixedColor": "#FCBE17"}},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 19,
      "title": "최근 7일 Worker 비용",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Hailcast Worker Pod의 CPU/Memory allocation 기반 최근 7일 비용입니다. Hailcast Namespace 비용에 포함되는 하위 범위이며 Node 비용과 합산하지 않습니다. AWS 실제 청구액이 아닙니다.",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 14},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "avg_over_time(\n  (\n    (\n      sum(\n        container_cpu_allocation{\n          namespace=\"hailcast\",\n          pod=~\"hailcast-worker-.*\",\n          container=\"worker\"\n        }\n        * on(node) group_left()\n        node_cpu_hourly_cost\n      )\n      or vector(0)\n    )\n    +\n    (\n      sum(\n        (\n          container_memory_allocation_bytes{\n            namespace=\"hailcast\",\n            pod=~\"hailcast-worker-.*\",\n            container=\"worker\"\n          }\n          / 1024 / 1024 / 1024\n        )\n        * on(node) group_left()\n        node_ram_hourly_cost\n      )\n      or vector(0)\n    )\n  )[7d:30s]\n)\n* 168",
          "legendFormat": "Worker 누적 할당 모델 비용",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "currencyUSD", "decimals": 2, "min": 0, "mappings": [], "color": {"mode": "fixed", "fixedColor": "#FCBE17"}},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 12,
      "title": "Kubernetes 비용 발생 위치",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "panels": []
    },
    {
      "id": 13,
      "title": "Node별 7일 비용",
      "type": "bargauge",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "OpenCost Node 가격 모델 기준 Node별 최근 7일 비용입니다. Node가 없었던 시간은 포함하지 않으며 AWS 실제 청구액이 아닙니다.",
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 19},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum_over_time(\n  (\n    sum by (node) (\n      node_total_hourly_cost\n    )\n  )[7d:30s]\n)\n/\nscalar(\n  count_over_time(vector(1)[7d:30s])\n)\n* 168",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "desc": true,
                "field": "Value"
              }
            ]
          }
        },
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "Time",
                "handlerKey": "__ignore"
              },
              {
                "fieldName": "Value",
                "handlerKey": "field.value"
              },
              {
                "fieldName": "Metric",
                "handlerKey": "field.name"
              }
            ]
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^([^.]+)\\.ap-northeast-2\\.compute\\.internal$",
            "renamePattern": "$1"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "currencyUSD", "decimals": 2, "min": 0, "mappings": [], "color": {"mode": "fixed", "fixedColor": "#FCBE17"}},
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true,
        "sizing": "auto",
        "text": {},
        "valueMode": "color"
      }
    },
    {
      "id": 14,
      "title": "Namespace별 7일 비용",
      "type": "bargauge",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Namespace별 CPU/Memory allocation 기반 최근 7일 비용입니다. Node idle·Storage·Network를 포함하지 않아 Node 비용과 계산 범위가 다르며 AWS 실제 청구액이 아닙니다.",
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 19},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum_over_time(\n  (\n    sum by (namespace) (\n      container_cpu_allocation\n      * on(node) group_left()\n      node_cpu_hourly_cost\n    )\n    +\n    sum by (namespace) (\n      (\n        container_memory_allocation_bytes\n        / 1024 / 1024 / 1024\n      )\n      * on(node) group_left()\n      node_ram_hourly_cost\n    )\n  )[7d:30s]\n)\n/\nscalar(\n  count_over_time(vector(1)[7d:30s])\n)\n* 168",
          "legendFormat": "{{namespace}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "desc": true,
                "field": "Value"
              }
            ]
          }
        },
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "Time",
                "handlerKey": "__ignore"
              },
              {
                "fieldName": "Value",
                "handlerKey": "field.value"
              },
              {
                "fieldName": "Metric",
                "handlerKey": "field.name"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "currencyUSD", "decimals": 2, "min": 0, "mappings": [], "color": {"mode": "fixed", "fixedColor": "#FCBE17"}},
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true,
        "sizing": "auto",
        "text": {},
        "valueMode": "color"
      }
    },
    {
      "id": 15,
      "title": "Worker Ready / 비용 추이",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Worker Ready 복제본과 Hailcast Worker Pod의 CPU/Memory allocation 기반 시간당 비용(USD/h)을 같은 시간축에서 비교합니다. scale-out·scale-in 전후 변화를 확인하는 운영 진단이며 인과관계·절감액·절감률을 의미하지 않습니다.",
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 19},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "(\n  sum(\n    container_cpu_allocation{\n      namespace=\"hailcast\",\n      pod=~\"hailcast-worker-.*\",\n      container=\"worker\"\n    }\n    * on(node) group_left()\n    node_cpu_hourly_cost\n  )\n  or vector(0)\n)\n+\n(\n  sum(\n    (\n      container_memory_allocation_bytes{\n        namespace=\"hailcast\",\n        pod=~\"hailcast-worker-.*\",\n        container=\"worker\"\n      }\n      / 1024 / 1024 / 1024\n    )\n    * on(node) group_left()\n    node_ram_hourly_cost\n  )\n  or vector(0)\n)",
          "legendFormat": "Worker 모델 비용",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "max(\n  kube_deployment_status_replicas_ready{\n    namespace=\"hailcast\",\n    deployment=\"hailcast-worker\"\n  }\n)\nor vector(0)",
          "legendFormat": "Worker Ready",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "min": 0,
          "mappings": [],
          "color": {"mode": "fixed", "fixedColor": "#FCBE17"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "시간당 할당 모델 비용 (USD/h)",
            "axisPlacement": "left",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Worker 모델 비용"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#FCBE17"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Worker Ready"},
            "properties": [
              {"id": "unit", "value": "short"},
              {"id": "decimals", "value": 0},
              {"id": "min", "value": 0},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "#3286F6"}},
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "custom.axisLabel", "value": "Worker Ready"},
