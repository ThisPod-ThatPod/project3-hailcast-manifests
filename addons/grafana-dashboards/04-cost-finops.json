          "parser": "jq-backend",
          "refId": "A",
          "root_selector": "[.data.sets[] | select((.cloudCosts | length) > 0) | {time: .window.start, cost: ([.cloudCosts[]?.netCost.cost] | add // 0)}]",
          "source": "url",
          "type": "json",
          "url": "/cloudCost?window=7d",
          "url_options": {"data": "", "method": "GET"}
        }
      ],
      "fieldConfig": {
