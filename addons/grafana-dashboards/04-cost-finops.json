    {
      "id": 4,
      "title": "최근 반영 AWS 비용",
      "type": "stat",
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "hailcast-opencost-api"},
      "description": "OpenCost /cloudCost 최근 7일 응답에서 데이터가 존재하는 최신 완료 일 구간의 CUR 기반 Net Cost 합계입니다. CUR 반영 지연이 있어 실시간 비용이 아닙니다.",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 1},
