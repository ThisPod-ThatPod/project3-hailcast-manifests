        {
          "columns": [{"selector": "cost", "text": "최신 완료 일 Net Cost", "type": "number"}],
          "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "hailcast-opencost-api"},
          "filters": [],
          "format": "table",
          "parser": "jq-backend",
          "refId": "A",
          "root_selector": "[.data.sets | map(select((.cloudCosts | length) > 0)) | last | {cost: ([.cloudCosts[]?.netCost.cost] | add // 0)}]",
          "source": "url",
