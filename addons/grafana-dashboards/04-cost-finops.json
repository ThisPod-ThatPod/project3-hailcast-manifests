      "type": "timeseries",
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "hailcast-opencost-api"},
      "description": "OpenCost /cloudCost 최근 7일의 완료된 일별 구간을 CUR 기반 Net Cost 합계로 표시합니다. 아직 비용 데이터가 없는 현재 일 구간은 제외합니다.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [
        {
          "columns": [
            {"selector": "time", "text": "Time", "type": "timestamp"},
            {"selector": "cost", "text": "AWS Net Cost", "type": "number"}
