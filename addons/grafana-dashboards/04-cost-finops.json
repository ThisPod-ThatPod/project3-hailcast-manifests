    {
      "id": 8,
      "title": "AWS 비용 Category 구성",
      "type": "piechart",
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "hailcast-opencost-api"},
      "description": "OpenCost /cloudCost 최근 7일 비용을 properties.category별로 합산한 CUR 기반 Net Cost 구성입니다.",
      "gridPos": {"h": 8, "w": 5, "x": 19, "y": 5},
      "targets": [
        {
          "columns": [
            {"selector": "category", "text": "Category", "type": "string"},
            {"selector": "cost", "text": "Net Cost", "type": "number"}
          ],
          "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "hailcast-opencost-api"},
          "filters": [],
          "format": "table",
          "parser": "jq-backend",
          "refId": "A",
          "root_selector": "[.data.sets[].cloudCosts[]?] | group_by(.properties.category // \"Other\") | map({category: (.[0].properties.category // \"Other\"), cost: (map(.netCost.cost // 0) | add)}) | sort_by(.cost) | reverse",
          "source": "url",
          "type": "json",
          "url": "/cloudCost?window=7d",
          "url_options": {"data": "", "method": "GET"}
        }
      ],
