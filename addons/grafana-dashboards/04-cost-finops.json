        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 7,
      "title": "AWS Service별 비용",
      "type": "barchart",
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "hailcast-opencost-api"},
      "description": "OpenCost /cloudCost 최근 7일 비용을 properties.service별로 합산한 CUR 기반 Net Cost입니다.",
      "gridPos": {"h": 8, "w": 7, "x": 12, "y": 5},
      "targets": [
        {
          "columns": [
            {"selector": "service", "text": "AWS Service", "type": "string"},
            {"selector": "cost", "text": "Net Cost", "type": "number"}
          ],
          "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "hailcast-opencost-api"},
          "filters": [],
          "format": "table",
          "parser": "jq-backend",
          "refId": "A",
          "root_selector": "[.data.sets[].cloudCosts[]?] | group_by(.properties.service // \"Unknown\") | map({service: (.[0].properties.service // \"Unknown\"), cost: (map(.netCost.cost // 0) | add)}) | sort_by(.cost) | reverse",
          "source": "url",
          "type": "json",
          "url": "/cloudCost?window=7d",
          "url_options": {"data": "", "method": "GET"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
