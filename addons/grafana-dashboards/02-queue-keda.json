{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 15,
      "title": "서비스 요청 처리 흐름",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 16,
      "title": "Call / SQS Publish 처리량 추이",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Call API가 노출하는 pod별 Counter의 5분 rate를 합산해 Call 접수량과 SQS Publish 성공량을 비교합니다. 두 Counter는 rollout/restart 시 reset되므로 누적 합계 대신 rate를 사용합니다. 정상 상태에서 두 Series가 거의 겹치는 것은 자연스럽습니다. 지속적인 차이는 Call 진입 후 Publish 기록까지의 지연이나 이상을 살펴보는 보조 신호이지만, 정확한 실패 건수·실패율·HTTP 오류율을 의미하지 않습니다.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(hailcast_request_total{service=\"hailcast-call-api\"}[5m]))",
          "legendFormat": "Call 접수",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(hailcast_queue_publish_total{service=\"hailcast-call-api\"}[5m]))",
          "legendFormat": "SQS Publish",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 건/s",
          "decimals": 2,
          "min": 0,
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "처리량 (건/s)",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Call 접수"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#E7C84A",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.fillOpacity",
                "value": 6
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SQS Publish"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#66C7D8",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 1,
      "title": "Queue 현황",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "현재 Queue",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Prometheus가 수집한 SQS visible message 기준의 현재 처리 대기열입니다. KEDA의 queueLength=500은 복제본당 처리 목표 계산에 사용하는 값이며 장애 임계값이 아닙니다. 운영 경보는 visible message가 2분 이상 1,000건을 초과할 때 발생하는 별도 PrometheusRule을 사용합니다.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(hailcast_queue_size{namespace=\"$namespace\", service=\"$predict_service\"})",
          "legendFormat": "현재 Queue",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 건",
          "decimals": 0,
          "mappings": [],
          "color": {
            "fixedColor": "#A8B3C2",
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 56
        },
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 11,
      "title": "KEDA Operator 상태",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "kube-state-metrics 기준으로 KEDA Operator 디플로이먼트(Deployment)에 사용 가능한 복제본이 있는지 표시합니다.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(\n  max(\n    kube_deployment_status_replicas_available{\n      namespace=\"keda\",\n      deployment=\"keda-operator\"\n    }\n  )\n  or max(\n    kube_deployment_status_replicas_available{\n      exported_namespace=\"keda\",\n      deployment=\"keda-operator\"\n    }\n  )\n  or vector(0)\n) > bool 0",
          "legendFormat": "KEDA Operator",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "#D96B75",
                  "index": 0,
                "text": "사용 불가"
                },
                "1": {
              "color": "green",
                  "index": 1,
                "text": "사용 가능"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#D96B75",
                "value": null
              },
              {
            "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 36
        },
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 6,
      "title": "반응형 스케일링",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "id": 12,
      "title": "반응형 스케일링 흐름",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Queue는 right Y-axis의 저강도 회색 context로, HPA 요구와 Worker Ready는 전면의 Replica 선으로 표시합니다. 원본 샘플과 시간 해상도는 그대로 유지합니다.",
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(hailcast_queue_size{namespace=\"$namespace\", service=\"$predict_service\"})",
          "legendFormat": "Queue (context)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(\n  kube_horizontalpodautoscaler_status_desired_replicas{\n    namespace=\"$namespace\",\n    horizontalpodautoscaler=\"keda-hpa-hailcast-worker-scaler\"\n  }\n)",
          "legendFormat": "HPA 요구",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(\n  kube_deployment_status_replicas_ready{\n    namespace=\"$namespace\",\n    deployment=\"$worker_deployment\"\n  }\n)",
          "legendFormat": "Worker Ready",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Replicas",
            "axisPlacement": "left",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Queue (context)"},
            "properties": [
              {"id": "unit", "value": "suffix: 건"},
              {"id": "min", "value": 0},
              {"id": "color", "value": {"fixedColor": "#7E8796", "mode": "fixed"}},
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "custom.axisLabel", "value": "Queue"},
              {"id": "custom.axisGridShow", "value": false},
              {"id": "custom.lineInterpolation", "value": "linear"},
              {"id": "custom.lineWidth", "value": 1},
              {"id": "custom.fillOpacity", "value": 8},
              {"id": "custom.showPoints", "value": "never"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "HPA 요구"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "#FCBE17", "mode": "fixed"}},
              {"id": "custom.lineWidth", "value": 5},
              {"id": "custom.fillOpacity", "value": 0}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Worker Ready"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "#3286F6", "mode": "fixed"}},
              {"id": "custom.lineWidth", "value": 3},
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "custom.lineStyle", "value": {"dash": [10, 6], "fill": "dash"}}
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "현재 스케일링 상태",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "현재 HPA 요구와 Worker Ready 복제본을 Metric identity 색상으로 비교합니다.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(\n  kube_horizontalpodautoscaler_status_desired_replicas{\n    namespace=\"$namespace\",\n    horizontalpodautoscaler=\"keda-hpa-hailcast-worker-scaler\"\n  }\n)",
          "legendFormat": "HPA 요구",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(\n  kube_deployment_status_replicas_ready{\n    namespace=\"$namespace\",\n    deployment=\"$worker_deployment\"\n  }\n)",
          "legendFormat": "Worker Ready",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "fieldMinMax": false,
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Worker Ready"
            },
            "properties": [
              {
                "id": "color",
                "value": {
              "fixedColor": "#3286F6",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HPA 요구"
            },
            "properties": [
              {
                "id": "color",
                "value": {
              "fixedColor": "#FCBE17",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "displayMode": "basic",
        "maxVizHeight": 300,
        "minVizHeight": 32,
        "minVizWidth": 8,
        "namePlacement": "top",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      }
    },
    {
      "id": 3,
      "title": "최근 5분 최대 Queue",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "최근 5분 hailcast_queue_size의 최댓값이며 SQS visible message 기준입니다. 이 패널 자체에는 색상 임계값을 적용하지 않으며, 운영 경보는 별도 PrometheusRule 기준을 사용합니다.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(\n  max_over_time(\n    hailcast_queue_size{namespace=\"$namespace\", service=\"$predict_service\"}[5m]\n  )\n)",
          "legendFormat": "최근 5분 최대 Queue",
          "refId": "A"
        }
      ],
    "fieldConfig": {
      "defaults": {
        "unit": "suffix: 건",
        "decimals": 0,
        "mappings": [],
        "color": {
          "fixedColor": "#A8B3C2",
          "mode": "fixed"
        }
      },
      "overrides": []
    },
    "options": {
      "colorMode": "value",
      "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 56
        },
        "textMode": "value",
        "wideLayout": true
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "hailcast",
    "queue",
    "keda",
    "hpa",
    "reactive-scaling"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "데이터 소스",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "네임스페이스",
        "type": "constant",
        "query": "hailcast",
        "current": {
          "text": "hailcast",
          "value": "hailcast"
        },
        "hide": 0
      },
      {
        "name": "worker_deployment",
        "label": "Worker 디플로이먼트",
        "type": "constant",
        "query": "hailcast-worker",
        "current": {
          "text": "hailcast-worker",
          "value": "hailcast-worker"
        },
        "hide": 0
      },
      {
        "name": "predict_service",
        "label": "Predict 서비스",
        "type": "constant",
        "query": "predict",
        "current": {
          "text": "predict",
          "value": "predict"
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
